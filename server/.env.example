PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/rentnest_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Optional Email Notification Settings (Nodemailer)
# If not provided, emails are automatically logged to console in simulation mode
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="RentNest Alerts <alerts@rentnest.com>"
